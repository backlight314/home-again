# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Gemini, for the guide, transcription and building the game
GEMINI_API_KEY=
PORT=8787

# Stage 1: TigerData (hosted Postgres) for the album, conversation and game.
# Leave unset to keep them as JSON files in data/. Copy existing data with: npm run migrate
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require
# FAMILY_ID=default

# Stage 2: an S3-compatible bucket for photos and voices (Cloudflare R2, Amazon S3, ...).
# Leave unset to keep them in data/media. npm run migrate also uploads existing files.
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2 or any non-AWS service; omit for AWS
# S3_REGION=auto                                             # "auto" for R2, e.g. us-east-1 for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
