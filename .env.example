# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Gemini, for the guide, transcription and building the game
GEMINI_API_KEY=
PORT=8787

# Stage 1: TigerData (hosted Postgres) for the album, conversation and game.
# Leave unset to keep them as JSON files in data/. Copy existing data with: npm run migrate
DATABASE_URL=postgres://user:password@host:port/tsdb?sslmode=require
# FAMILY_ID=default

# Stage 2: an S3-compatible bucket for photos and voices (Cloudflare R2, Amazon S3, ...).
# Leave unset to keep them in data/media. npm run migrate also uploads existing files.
# S3_BUCKET=
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com   # R2 or any non-AWS service; omit for AWS
# S3_REGION=auto                                             # "auto" for R2, e.g. us-east-1 for AWS
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Snowflake, for the family's Insights tab: play events, weekly trends and a summary
# written by Snowflake Cortex. Leave unset to keep events in data/events.jsonl.
# Sample history for demos: npm run seed-snowflake   (remove: npm run seed-snowflake -- --clear)
# SNOWFLAKE_ACCOUNT=myorg-myaccount           # account identifier, or the full https://... account URL
# SNOWFLAKE_TOKEN=                            # programmatic access token (Snowsight: profile > Settings > Authentication)
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_ROLE=                             # optional; the token's default role otherwise
# SNOWFLAKE_DATABASE=HOME_AGAIN               # created if missing
# SNOWFLAKE_CORTEX_MODEL=claude-sonnet-4-5    # any Cortex COMPLETE model available in your region

# ElevenLabs, for spoken captions and letter lines that have no family recording.
# Each line is made once and kept with the album's media. Leave unset to use the browser voice.
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=XrExE9yKIg1WjnnlVkGX   # Matilda (default). Library voices need a paid plan
# ELEVENLABS_MODEL=eleven_multilingual_v2
